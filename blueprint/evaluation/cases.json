      "id": "C26", "type": "contract", "operation": "capture", "controls": ["H09"],
      "input": {"mutations": ["add top-level toolCall key", "energy value is string rather than integer", "unknown operation", "mismatched request ID", "duplicate proposal for one field"]},
      "expected": {"structuralMutationsRejectedBySchema": true, "identityAndDuplicateMutationsRejectedByHost": true, "noSourceWrite": true}
