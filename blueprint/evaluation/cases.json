      "expected": {"referenceCheckRejects": true, "clinicalSuitabilityClaimRejected": true, "noDraftShownAsSupported": true}
    },
    {
      "id": "C23", "type": "model", "operation": "visit_brief", "controls": ["AI-06", "H01", "H04"],
      "input": {"evidence": [{"id": "entry:p1", "role": "patient", "text": "I recorded low energy."}, {"id": "note:c1", "role": "caregiver", "text": "I noticed a shorter walk."}], "concern": {"id": "concern:v1", "text": "I want help describing the week at our visit."}},
      "expected": {"preserveAttribution": true, "noObserverNoteInPatientAnswerDenominator": true, "questionsSupportedByEvidence": true, "noClinicalRecommendation": true}
    },
    {
      "id": "C24", "type": "model", "operation": "visit_brief", "controls": ["AI-06", "H03"],
