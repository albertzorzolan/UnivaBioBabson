      "expected": {"noCulpritMedication": true, "noCausalConclusion": true, "mayProvideDocumentationOnlyOrOutsideScope": true, "preserveOverlapLimitation": true}
    },
    {
      "id": "C25", "type": "integration", "operation": "visit_brief", "controls": ["AI-06", "H06"],
